+/* The old Sound Driver (refNum -4, IM II-221).  Free-form writes play
+ * through a private Sound Manager channel; the callBackCmd queued after
+ * the buffer completes the write.  Square-wave and four-tone writes
+ * still complete at once without sound. */
+static SndChannelPtr sd_chan;
+static ParmBlkPtr sd_pb;
+static SoundHeaderPtr sd_hdr;
+
+static void sound_driver_done(OSErr err)
+{
+    ParmBlkPtr pb = sd_pb;
+    if(!pb)
+        return;
+    sd_pb = nullptr;
+    pb->ioParam.ioResult = err;
+    pb->ioParam.ioActCount = pb->ioParam.ioReqCount;
+    if(ProcPtr compp = pb->ioParam.ioCompletion)
+        CALLCOMPLETION(pb, compp, err);
+}
+
+static void sound_driver_stop()
+{
+    SndCommand cmd;
+    cmd.param1 = 0;
+    cmd.param2 = 0;
+    cmd.cmd = flushCmd;
+    SndDoImmediate(sd_chan, &cmd);
+    cmd.cmd = quietCmd;
+    SndDoImmediate(sd_chan, &cmd);
+    if(sd_pb)
+    {
+        sd_pb->ioParam.ioResult = abortErr;
+        sd_pb = nullptr;
+    }
+}
+
+/* Returns 1 when the write is still playing. */
+OSErr Executor::ROMlib_sound_driver_write(ParmBlkPtr pb, bool async)
+{
+    Ptr buf = pb->ioParam.ioBuffer;
+    LONGINT n = pb->ioParam.ioReqCount;
+
+    if(ROMlib_PretendSound != soundon || n <= 6
+       || *(GUEST<INTEGER> *)buf != 0 /* ffMode */)
+        return noErr;
+
+    if(!sd_chan)
+    {
+        GUEST<SndChannelPtr> chan = nullptr;
+        SndNewChannel(&chan, sampledSynth, 0, nullptr);
+        sd_chan = chan;
+        sd_hdr = (SoundHeaderPtr)NewPtrSysClear(sizeof(SoundHeader));
+    }
+    sound_driver_stop();
+
+    /* FFSynthRec: mode, count (Fixed, 1.0 = 22254.54 Hz), waveBytes */
+    sd_hdr->samplePtr = buf + 6;
+    sd_hdr->length = n - 6;
+    sd_hdr->sampleRate = (Fixed)(((uint64_t)(uint32_t)*(GUEST<Fixed> *)(buf + 2) * 0x56EE8BA3ULL) >> 16);
+    sd_hdr->encode = stdSH;
+    sd_hdr->baseFrequency = 60;
+
+    sd_pb = pb;
+    pb->ioParam.ioResult = 1;
+
+    SndCommand cmd;
+    cmd.cmd = bufferCmd;
+    cmd.param1 = 0;
+    cmd.param2 = guest_cast<LONGINT>(sd_hdr);
+    SndDoCommand(sd_chan, &cmd, false);
+    cmd.cmd = callBackCmd;
+    cmd.param2 = 0;
+    SndDoCommand(sd_chan, &cmd, false);
+
+    if(!async)
+    {
+        wait_on_channel(sd_chan);
+        return pb->ioParam.ioResult;
+    }
+    return 1;
+}
+
+/* Some early games (Dark Castle) skip the Sound Driver and write samples
+ * into the 370-word buffer at SoundBase from a VBL task, one sample in the
+ * high byte of each word.  Called once per VBL with the ticks elapsed. */
+void Executor::ROMlib_sound_hardware_frames(int ticks)
+{
+    if(ROMlib_PretendSound != soundon || ticks <= 0 || !LM(SoundBase))
+        return;
+
+    GUEST<uint16_t> *p = (GUEST<uint16_t> *)(Ptr)LM(SoundBase);
+    uint8_t buf[370];
+    bool flat = true;
+    for(int i = 0; i < 370; i++)
+    {
+        buf[i] = p[i] >> 8;
+        flat = flat && buf[i] == buf[0];
+    }
+    if(flat)
+        return;
+    for(int i = 0; i < ticks && i < 4; i++)
+        sound_driver->hardware_frame(buf, 370, 370 * 60);
+}
+
+void Executor::ROMlib_sound_driver_kill()
+{
+    if(sd_chan)
+        sound_driver_stop();
+}
