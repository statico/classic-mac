 using namespace Executor;
 
 static WasmVideoDriver *instance;
 
+// The fake driver already paces the Sound Manager with Time Manager tasks
+// (one 2048-sample buffer every ~92 ms).  We keep that pacing and hand each
+// mixed buffer to the page, which plays it with Web Audio.
+class WasmSound : public SoundFake
+{
+public:
+    HungerInfo HungerStart() override
+    {
+        HungerInfo info = SoundFake::HungerStart();
+        mixing_ = true;
+        memset(info.buf, 0x80, info.bufsize); // channels mix into silence
+        buf_ = info.buf;
+        size_ = info.bufsize;
+        rate_ = info.rate;
+        return info;
+    }
+    void HungerFinish() override
+    {
+        mixing_ = false;
+        EM_ASM({ if(Module.executorAudio) Module.executorAudio($0, $1, $2, 0); }, buf_, size_, rate_);
+        SoundFake::HungerFinish();
+    }
+    bool sound_silent() override { return false; }
+    void hardware_frame(const uint8_t *samples, int n, int rate) override
+    {
+        EM_ASM({ if(Module.executorAudio) Module.executorAudio($0, $1, $2, 1); }, samples, n, rate);
+    }
+    // SoundFake::sound_go mixes right away.  A callBackCmd that runs during
+    // the mix and queues more sound (Glider PRO) would recurse without end.
+    void sound_go() override
+    {
+        if(!mixing_)
+            SoundFake::sound_go();
+    }
+
+private:
+    bool mixing_ = false;
+    uint8_t *buf_;
+    int size_, rate_;
+};
+
 WasmVideoDriver::WasmVideoDriver(IEventListener *listener, int&, char*[])
     : VideoDriver(listener)
 {
     instance = this;
+    sound_driver = new WasmSound();
+    if(!sound_disabled_p)
+        ROMlib_PretendSound = soundon;
 }
 
 bool WasmVideoDriver::setMode(int width, int height, int bpp, bool grayscale_p)
