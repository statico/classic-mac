+/* Fills a 28-byte SoundComponentData from the first sound header. */
+OSErr Executor::C_ParseSndHeader(Handle sndHandle, Ptr sndInfo,
+                                 GUEST<ULONGINT> *numFrames, GUEST<ULONGINT> *dataOffset)
+{
+    GUEST<LONGINT> off;
+    OSErr err = C_GetSoundHeaderOffset(sndHandle, &off);
+    if(err != noErr)
+        return err;
+
+    auto get32 = [](const uint8_t *p) { return uint32_t(p[0] << 24 | p[1] << 16 | p[2] << 8 | p[3]); };
+    auto put32 = [](Ptr p, uint32_t v) { p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v; };
+    const uint8_t *h = (const uint8_t *)*sndHandle + off;
+    uint32_t channels = 1, frames = get32(h + 4), bits = 8, format = "raw "_4, data = 22;
+
+    if(h[20] == extSH || h[20] == cmpSH)
+    {
+        channels = get32(h + 4);
+        frames = get32(h + 22);
+        bits = h[48] << 8 | h[49];
+        format = h[20] == cmpSH ? get32(h + 40) : bits == 16 ? "twos"_4 : "raw "_4;
+        data = 64;
+    }
+    memset(sndInfo, 0, 28);
+    put32(sndInfo + 4, format);
+    sndInfo[8] = channels >> 8; sndInfo[9] = channels;
+    sndInfo[10] = bits >> 8; sndInfo[11] = bits;
+    memcpy(sndInfo + 12, h + 8, 4); /* sampleRate */
+    put32(sndInfo + 16, frames);
+    *numFrames = frames;
+    *dataOffset = off + data;
+    return noErr;
+}
