--- /dev/null
+++ b/src/config/front-ends/wasm/wasm.h
@@ -0,0 +1,25 @@
+#pragma once
+
+#include <vdriver/vdriver.h>
+#include <vector>
+
+// Single-threaded browser video driver.  The emulator runs on the browser
+// main thread; it calls executor_wasm_yield() (see syncint.cpp) to present
+// the screen and let the browser deliver input events.
+class WasmVideoDriver : public Executor::VideoDriver
+{
+public:
+    WasmVideoDriver(Executor::IEventListener *listener, int& argc, char* argv[]);
+
+    bool setMode(int width, int height, int bpp, bool grayscale_p) override;
+    void runEventLoop() override {}
+    void endEventLoop() override;
+    void beepAtUser() override;
+
+    void present();
+    Executor::IEventListener *listener() { return callbacks_; }
+
+private:
+    void requestUpdate() override {}
+    std::vector<uint32_t> rgba_;
+};
