index 45578e07..8c897b67 100644
--- a/src/util/macstrings.h
+++ b/src/util/macstrings.h
@@ -4,6 +4,53 @@
 #include <string_view>
 #include <rsys/filesystem.h>
 #include <base/mactype.h>
+#include <cstring>
+
+#if defined(_LIBCPP_VERSION) && _LIBCPP_VERSION >= 190000
+// libc++ 19 removed the generic std::char_traits template.
+template<>
+struct std::char_traits<unsigned char>
+{
+    using char_type = unsigned char;
+    using int_type = int;
+    using off_type = std::streamoff;
+    using pos_type = std::streampos;
+    using state_type = std::mbstate_t;
+
+    static constexpr void assign(char_type& a, const char_type& b) noexcept { a = b; }
+    static constexpr bool eq(char_type a, char_type b) noexcept { return a == b; }
+    static constexpr bool lt(char_type a, char_type b) noexcept { return a < b; }
+    static constexpr int compare(const char_type* a, const char_type* b, size_t n)
+    {
+        for(; n; --n, ++a, ++b)
+            if(*a != *b)
+                return *a < *b ? -1 : 1;
+        return 0;
+    }
+    static constexpr size_t length(const char_type* s)
+    {
+        size_t n = 0;
+        while(s[n])
+            ++n;
+        return n;
+    }
