diff --git a/src/config/front-ends/wasm/wasm.cpp b/src/config/front-ends/wasm/wasm.cpp
new file mode 100644
index 00000000..7aa610f8
--- /dev/null
+++ b/src/config/front-ends/wasm/wasm.cpp
@@ -0,0 +1,92 @@
+#include "wasm.h"
+#include <emscripten.h>
+
+using namespace Executor;
+
+static WasmVideoDriver *instance;
+
+WasmVideoDriver::WasmVideoDriver(IEventListener *listener, int&, char*[])
+    : VideoDriver(listener)
+{
+    instance = this;
+}
+
+bool WasmVideoDriver::setMode(int width, int height, int bpp, bool grayscale_p)
+{
+    if(!width || !height)
+    {
+        width = framebuffer_.width ? framebuffer_.width : 640;
+        height = framebuffer_.height ? framebuffer_.height : 480;
+    }
+    if(!bpp)
+        bpp = framebuffer_.bpp ? framebuffer_.bpp : 8;
+
+    framebuffer_ = Framebuffer(width, height, bpp);
+    framebuffer_.grayscale = grayscale_p;
+    rgba_.assign(width * height, 0xFF000000);
+
+    EM_ASM({ if(Module.executorSetMode) Module.executorSetMode($0, $1); }, width, height);
+    dirtyRects_.add(0, 0, height, width);
+    return true;
+}
+
+void WasmVideoDriver::present()
+{
+    DirtyRects::Rects rects;
+    {
+        std::lock_guard lk(mutex_);
+        if(dirtyRects_.empty())
+            return;
+        rects = dirtyRects_.getAndClear();
+    }
+    int w = width(), h = height();
+    updateBuffer(framebuffer_, rgba_.data(), w, h, rects);
+
+    // updateBuffer produces 0xAARRGGBB; canvas ImageData wants R,G,B,A bytes.
+    for(const auto& r : rects)
+        for(int y = r.top; y < r.bottom && y < h; y++)
+            for(uint32_t *p = &rgba_[y * w + r.left], *e = &rgba_[y * w + std::min(r.right, w)]; p < e; p++)
+                *p = (*p & 0xFF00FF00) | ((*p >> 16) & 0xFF) | ((*p & 0xFF) << 16) | 0xFF000000;
+
+    EM_ASM({ Module.executorBlit($0, $1, $2); }, rgba_.data(), w, h);
+}
+
+void WasmVideoDriver::endEventLoop()
+{
+    EM_ASM({ if(Module.executorExited) Module.executorExited(); });
+}
+
+void WasmVideoDriver::beepAtUser()
+{
+    EM_ASM({ if(Module.executorBeep) Module.executorBeep(); });
+}
+
+// Called from syncint.cpp whenever the emulator idles or has run for a while.
+void executor_wasm_yield(int ms)
+{
+    if(instance)
+        instance->present();
+    emscripten_sleep(ms);
+}
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE void executor_mouse_moved(int h, int v)
+{
+    if(instance)
+        instance->listener()->mouseMoved(h, v);
+}
+
+EMSCRIPTEN_KEEPALIVE void executor_mouse_button(int down, int h, int v)
+{
+    if(instance)
+        instance->listener()->mouseButtonEvent(down != 0, h, v);
+}
+
+EMSCRIPTEN_KEEPALIVE void executor_key(int down, int mkvkey)
+{
+    if(instance)
+        instance->listener()->keyboardEvent(down != 0, (unsigned char)mkvkey);
+}
+
+}
