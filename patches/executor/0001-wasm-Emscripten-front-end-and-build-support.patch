@@ -191,8 +210,31 @@ SyncintTimer::SyncintTimer()
 #endif
 }
 
+#ifdef __EMSCRIPTEN__
+void SyncintTimer::poll(bool mayYield)
+{
+    double now = emscripten_get_now();
+    if(deadline && now >= deadline)
+    {
+        deadline = 0;
+        timerInterrupt.trigger();
+    }
+    // Keep the browser responsive (screen updates, input) while the
+    // emulated program is busy.
+    if(mayYield && now - lastYield > 20)
+    {
+        lastYield = now;
+        executor_wasm_yield(0);
+    }
+}
+#endif
+
 void SyncintTimer::start()
 {
+#ifdef __EMSCRIPTEN__
+    syn68k_poll_hook = [] { timer.poll(true); };
+    return;
+#endif
 #if USE_TIMER_THREAD
     thread = std::thread([this] {
         std::unique_lock<std::mutex> lock(mutex);
@@ -249,6 +291,13 @@ SyncintTimer::~SyncintTimer()
 
 void SyncintTimer::post(std::chrono::microseconds usecs, bool fromLast)
 {
+#ifdef __EMSCRIPTEN__
+    // same semantics as setitimer(): replace any pending timer
+    deadline = emscripten_get_now() + usecs.count() / 1000.0;
+    if(deadline == 0)
+        deadline = 1e-9;
+    return;
+#endif
 #if USE_TIMER_THREAD
     std::unique_lock<std::mutex> lock(mutex);
 
@@ -273,6 +322,20 @@ void SyncintTimer::post(std::chrono::microseconds usecs, bool fromLast)
 
 void SyncintTimer::wait()
 {
+#ifdef __EMSCRIPTEN__
+    while(!INTERRUPT_PENDING())
+    {
+        poll(false);
+        if(INTERRUPT_PENDING())
+            break;
+        double ms = 16;
+        if(deadline)
+            ms = std::max(0.0, std::min(ms, deadline - emscripten_get_now()));
+        lastYield = emscripten_get_now();
+        executor_wasm_yield((int)ms);
+    }
+    return;
+#endif
 #if USE_TIMER_THREAD
     using namespace std::literals::chrono_literals;
 
