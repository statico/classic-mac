From 50b292d7c3d808d8c9e6b4016496c2bc5fa0cec9 Mon Sep 17 00:00:00 2001
From: Ian Langworth <ian@langworth.com>
Date: Tue, 27 Oct 2026 18:48:39 -0700
Subject: [PATCH] wasm: drop pointer high byte when an address falls outside
 memory

Old apps (Dark Castle) keep flags in a pointer's high byte, which a 24-bit
Mac ignores. On wasm such addresses trap; strip the byte there instead.
---
 include/syn68k_public.h | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/include/syn68k_public.h b/include/syn68k_public.h
index 6da10dc..9334568 100644
--- a/include/syn68k_public.h
+++ b/include/syn68k_public.h
@@ -252,7 +252,20 @@ extern int emulation_depth;
 #if SIZEOF_CHAR_P == 4 && !defined(TWENTYFOUR_BIT_ADDRESSING)
 
 extern uint32 ROMlib_offset;
+#ifdef __wasm__
+/* Old apps keep flags in a pointer's high byte, which a 24-bit Mac ignores.
+ * Such an address lands past the end of wasm memory and traps, so drop the
+ * high byte there.  Addresses inside memory are left alone. */
+static inline uint16 *SYN68K_TO_US(uint32 addr)
+{
+  uint32 h = addr + ROMlib_offset;
+  if (h >= (uint32) __builtin_wasm_memory_size(0) << 16)
+    h = (addr & 0x00FFFFFF) + ROMlib_offset;
+  return (uint16 *) h;
+}
+#else
 #define SYN68K_TO_US(addr) ((uint16 *) ((unsigned long)addr + ROMlib_offset)) /* uint16 * only the default. */
+#endif
 #define US_TO_SYN68K(addr) (/*(syn68k_addr_t)*/(int32) (addr) - ROMlib_offset)
 
 #else
